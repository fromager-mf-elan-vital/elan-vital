--- index.html (原始)
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Élan Vital - Bien-être & Développement personnel</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
@keyframes slideUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:translateY(0)}}
.fade-in{animation:fadeIn .5s ease-out}
.slide-up{animation:slideUp .6s ease-out}
.pulse-anim{animation:pulse 2s ease-in-out infinite}
.screen{display:none}.screen.active{display:block}
.tab-active{background:linear-gradient(135deg,#8b5cf6,#ec4899);color:white;box-shadow:0 4px 15px rgba(139,92,246,0.4)}
.badge{display:inline-flex;align-items:center;gap:4px;padding:2px 10px;border-radius:9999px;font-size:0.75rem;font-weight:600}
.progress-ring{transform:rotate(-90deg)}
</style>
</head>
<body class="bg-gradient-to-br from-purple-50 via-blue-50 to-pink-50 min-h-screen">

<!-- NAVIGATION BOTTOM -->
<nav id="bottom-nav" class="fixed bottom-0 left-0 right-0 bg-white/90 backdrop-blur-lg border-t border-purple-100 z-50 hidden">
<div class="max-w-lg mx-auto flex justify-around py-2">
<button onclick="showScreen('screen-home')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400 hover:text-purple-600 transition-colors" data-screen="screen-home">
<span class="text-xl">🏠</span><span class="text-xs">Accueil</span>
</button>
<button onclick="showScreen('screen-programs')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400 hover:text-purple-600 transition-colors" data-screen="screen-programs">
<span class="text-xl">📅</span><span class="text-xs">Programmes</span>
</button>
<button onclick="showScreen('screen-library')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400 hover:text-purple-600 transition-colors" data-screen="screen-library">
<span class="text-xl">📚</span><span class="text-xs">Exercices</span>
</button>
<button onclick="showScreen('screen-journal')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400 hover:text-purple-600 transition-colors" data-screen="screen-journal">
<span class="text-xl">📔</span><span class="text-xs">Journal</span>
</button>
<button onclick="showScreen('screen-profile')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400 hover:text-purple-600 transition-colors" data-screen="screen-profile">
<span class="text-xl">👤</span><span class="text-xs">Profil</span>
</button>
</div>
</nav>

<div id="app" class="pb-20">

<!-- ===== ACCUEIL ===== -->
<div id="screen-welcome" class="screen active min-h-screen flex flex-col items-center justify-center px-4 py-12">
<div class="max-w-2xl mx-auto text-center">
<div class="mb-8">
<div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-br from-purple-200 to-pink-200 shadow-xl mb-6 pulse-anim"><span class="text-5xl">🌿</span></div>
<h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-purple-700 via-pink-600 to-amber-600 bg-clip-text text-transparent mb-2">Élan Vital</h1>
<p class="text-lg text-gray-500">Bien-être & Développement personnel</p>
</div>
<div class="bg-white/60 rounded-3xl p-8 md:p-10 shadow-xl border border-white/80 mb-8">
<p class="text-xl md:text-2xl text-gray-700 mb-6">Bienvenue, toi. ✨</p>
<p class="text-gray-600 mb-4">Tu as envie de te sentir mieux, de te reconnecter à toi-même, de donner un nouvel élan à ta vie ? Tu es au bon endroit.</p>
<p class="text-gray-600 mb-4">Ici, pas de jugement. Juste des <strong class="text-purple-700">exercices bienveillants</strong> pour :</p>
<div class="grid grid-cols-2 gap-3 my-6">
<div class="bg-purple-50 rounded-xl p-3 border border-purple-100"><span class="text-lg">🧘</span><p class="text-sm text-purple-700 mt-1">Mieux te connaître</p></div>
<div class="bg-pink-50 rounded-xl p-3 border border-pink-100"><span class="text-lg">💪</span><p class="text-sm text-pink-700 mt-1">Retrouver ta force</p></div>
<div class="bg-amber-50 rounded-xl p-3 border border-amber-100"><span class="text-lg">🌱</span><p class="text-sm text-amber-700 mt-1">Grandir chaque jour</p></div>
<div class="bg-green-50 rounded-xl p-3 border border-green-100"><span class="text-lg">☀️</span><p class="text-sm text-green-700 mt-1">Vivre pleinement</p></div>
</div>
<div class="bg-gradient-to-r from-purple-100 to-pink-100 rounded-2xl p-4 mb-6">
<p class="text-purple-800 text-sm font-medium">🎁 +30 exercices • Programmes guidés • Journal personnel • Suivi de progression • Badges & récompenses</p>
</div>
</div>
<button onclick="showScreen('screen-questionnaire')" class="px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-2xl font-semibold text-lg shadow-xl hover:scale-105 transition-all">Commencer mon parcours →</button>
<div class="mt-10 p-4 bg-green-50/80 rounded-2xl border border-green-200/50">
<p class="text-sm text-green-800">🌿 <strong>Élan Vital</strong> est un outil de développement personnel et de bien-être.</p>
</div>
</div>
</div>

<!-- ===== QUESTIONNAIRE ===== -->
<div id="screen-questionnaire" class="screen min-h-screen flex flex-col items-center justify-center px-4 py-12">
<div class="max-w-2xl mx-auto w-full">
<div class="mb-8">
<div class="flex items-center justify-between mb-2"><span class="text-sm text-gray-500">Question <span id="q-current">1</span> sur 5</span><span class="text-sm text-purple-600 font-medium"><span id="q-percent">20</span>%</span></div>
<div class="w-full h-2 bg-purple-100 rounded-full overflow-hidden"><div id="q-progress" class="h-full bg-gradient-to-r from-purple-400 to-pink-400 rounded-full transition-all duration-500" style="width:20%"></div></div>
</div>
<div class="bg-white/70 rounded-3xl p-8 shadow-xl border border-white/80">
<h2 id="q-title" class="text-2xl md:text-3xl font-bold text-gray-800 mb-3"></h2>
<p id="q-subtitle" class="text-gray-500 text-lg italic mb-8"></p>
<div id="q-options" class="space-y-3 mb-8"></div>
<div class="flex items-center justify-between">
<button id="q-back" onclick="prevQuestion()" class="px-5 py-3 text-gray-500 hover:text-gray-700 transition-colors" disabled>← Retour</button>
<button id="q-next" onclick="nextQuestion()" class="px-8 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-xl font-semibold shadow-lg hover:scale-105 transition-all" disabled>Suivant →</button>
</div>
</div>
</div>
</div>

<!-- ===== PAGE D'ACCUEIL (après questionnaire) ===== -->
<div id="screen-home" class="screen min-h-screen px-4 py-8">
<div class="max-w-4xl mx-auto">
<!-- Salut -->
<div class="bg-gradient-to-r from-purple-500 to-pink-500 rounded-3xl p-8 text-white shadow-xl mb-8">
<h1 class="text-2xl md:text-3xl font-bold mb-2">Bonjour toi ! 🌿</h1>
<p class="text-purple-100 mb-4">Prêt·e pour ta séance du jour ?</p>
<div class="flex items-center gap-4">
<div class="bg-white/20 rounded-xl px-4 py-2"><span class="text-2xl font-bold" id="streak-count">0</span><p class="text-xs text-purple-100">jours d'affilée 🔥</p></div>
<div class="bg-white/20 rounded-xl px-4 py-2"><span class="text-2xl font-bold" id="exercises-done">0</span><p class="text-xs text-purple-100">exercices faits ✨</p></div>
<div class="bg-white/20 rounded-xl px-4 py-2"><span class="text-2xl font-bold" id="level-display">1</span><p class="text-xs text-purple-100">niveau 🏆</p></div>
</div>
</div>

<!-- Défi du jour -->
<div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-2xl p-6 border border-amber-200 mb-6">
<div class="flex items-center gap-3 mb-3"><span class="text-2xl">🔥</span><h3 class="font-bold text-amber-800">Défi du jour</h3></div>
<p id="daily-challenge" class="text-amber-700 mb-3"></p>
<button onclick="completeDailyChallenge()" class="px-4 py-2 bg-amber-500 text-white rounded-lg text-sm font-semibold hover:bg-amber-600 transition-colors">✓ Défi accompli !</button>
</div>

<!-- Exercice recommandé -->
<div class="bg-white/70 rounded-2xl p-6 border border-white/80 shadow-lg mb-6">
<h3 class="font-bold text-gray-800 mb-4 flex items-center gap-2"><span>✨</span> Exercice recommandé pour toi</h3>
<div id="recommended-exercise" class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-4 border border-purple-100 cursor-pointer hover:shadow-md transition-all"></div>
</div>

<!-- Programmes -->
<div class="mb-6">
<h3 class="font-bold text-gray-800 mb-4 flex items-center gap-2"><span>📅</span> Programmes en cours</h3>
<div class="grid md:grid-cols-2 gap-4" id="home-programs"></div>
</div>

<!-- Accès rapide -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
<button onclick="showScreen('screen-library')" class="bg-white/70 rounded-xl p-4 text-center border border-white/80 hover:shadow-lg transition-all"><span class="text-2xl">📚</span><p class="text-xs text-gray-600 mt-1">Exercices</p></button>
<button onclick="showScreen('screen-journal')" class="bg-white/70 rounded-xl p-4 text-center border border-white/80 hover:shadow-lg transition-all"><span class="text-2xl">📔</span><p class="text-xs text-gray-600 mt-1">Journal</p></button>
<button onclick="showScreen('screen-programs')" class="bg-white/70 rounded-xl p-4 text-center border border-white/80 hover:shadow-lg transition-all"><span class="text-2xl">📅</span><p class="text-xs text-gray-600 mt-1">Programmes</p></button>
<button onclick="showScreen('screen-pricing')" class="bg-gradient-to-r from-amber-400 to-orange-400 rounded-xl p-4 text-center hover:shadow-lg transition-all"><span class="text-2xl">⭐</span><p class="text-xs text-white mt-1 font-semibold">Premium</p></button>
</div>
</div>
</div>

<!-- ===== PROGRAMMES ===== -->
<div id="screen-programs" class="screen min-h-screen px-4 py-8">
<div class="max-w-4xl mx-auto">
<h1 class="text-3xl font-bold text-gray-800 mb-2">📅 Programmes guidés</h1>
<p class="text-gray-600 mb-8">Des parcours structurés pour transformer ta vie, un jour à la fois.</p>
<div id="programs-list" class="space-y-6"></div>
</div>
</div>

<!-- ===== BIBLIOTHÈQUE ===== -->
<div id="screen-library" class="screen min-h-screen px-4 py-8">
<div class="max-w-5xl mx-auto">
<h1 class="text-3xl font-bold text-gray-800 mb-2">📚 Bibliothèque d'exercices</h1>
<p class="text-gray-600 mb-6">Explore tous les exercices disponibles.</p>
<!-- Filtres -->
<div class="flex flex-wrap gap-2 mb-6">
<button onclick="filterExercises('all')" class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-purple-500 text-white">✨ Tous</button>
<button onclick="filterExercises('meditation')" class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-white/70 text-gray-600 border border-gray-200">🧘 Méditation</button>
<button onclick="filterExercises('ancrage')" class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-white/70 text-gray-600 border border-gray-200">🌳 Ancrage</button>
<button onclick="filterExercises('art-therapie')" class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-white/70 text-gray-600 border border-gray-200">🎨 Créativité</button>
<button onclick="filterExercises('emotionnel')" class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-white/70 text-gray-600 border border-gray-200">💛 Connaissance</button>
<button onclick="filterExercises('gratitude')" class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-white/70 text-gray-600 border border-gray-200">🙏 Gratitude</button>
<button onclick="filterExercises('confiance')" class="filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-white/70 text-gray-600 border border-gray-200">💎 Confiance</button>
</div>
<!-- Bannière Premium -->
<div id="premium-banner" class="mb-6 bg-gradient-to-r from-purple-500 to-pink-500 rounded-2xl p-6 text-white shadow-xl">
<div class="flex flex-col md:flex-row items-center gap-4">
<div class="flex-1"><h3 class="text-xl font-bold mb-2">✨ Débloque les 20+ exercices premium</h3><p class="text-purple-100 text-sm">Programmes complets, exercices avancés, nouveautés chaque mois.</p></div>
<button onclick="showScreen('screen-pricing')" class="px-6 py-3 bg-white text-purple-600 rounded-xl font-bold hover:scale-105 transition-transform shadow-lg whitespace-nowrap">Voir les offres →</button>
</div>
</div>
<div id="exercises-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
</div>
</div>

<!-- ===== EXERCICE DÉTAIL ===== -->
<div id="screen-exercise" class="screen min-h-screen px-4 py-8">
<div class="max-w-3xl mx-auto">
<button onclick="showScreen('screen-library')" class="flex items-center gap-2 text-gray-500 hover:text-purple-600 mb-6">← Retour</button>
<div id="exercise-content" class="bg-white/70 rounded-3xl p-8 shadow-xl border border-white/80 mb-8"></div>
<div id="exercise-steps" class="space-y-4 mb-8"></div>
<button onclick="completeExercise()" id="complete-btn" class="w-full py-4 bg-gradient-to-r from-green-500 to-emerald-500 text-white rounded-xl font-bold text-lg shadow-lg hover:scale-105 transition-all mb-8">✓ Exercice terminé !</button>
</div>
</div>

<!-- ===== JOURNAL ===== -->
<div id="screen-journal" class="screen min-h-screen px-4 py-8">
<div class="max-w-3xl mx-auto">
<h1 class="text-3xl font-bold text-gray-800 mb-2">📔 Mon journal</h1>
<p class="text-gray-600 mb-6">Un espace privé pour écrire, réfléchir et grandir.</p>
<div class="bg-white/70 rounded-2xl p-6 border border-white/80 shadow-lg mb-6">
<textarea id="journal-input" class="w-full h-40 p-4 bg-white/80 rounded-xl border border-gray-200 focus:border-purple-400 focus:ring-2 focus:ring-purple-200 outline-none resize-none text-gray-700" placeholder="Écris ici ce qui te traverse l'esprit... Pas de jugement, juste toi. 🌿"></textarea>
<div class="flex gap-3 mt-4">
<select id="journal-mood" class="px-4 py-2 bg-white rounded-xl border border-gray-200 text-gray-700">
<option value="">Comment tu te sens ?</option>
<option value="😊">😊 Heureux·se</option>
<option value="😌">😌 Calme</option>
<option value="🤔">🤔 Réfléchi·e</option>
<option value="😔">😔 Triste</option>
<option value="😤">😤 Frustré·e</option>
<option value="😰">😰 Anxieux·se</option>
<option value="🥰">🥰 Reconnaissant·e</option>
<option value="💪">💪 Motivé·e</option>
</select>
<button onclick="saveJournalEntry()" class="px-6 py-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-xl font-semibold hover:scale-105 transition-all">Enregistrer</button>
</div>
</div>
<div id="journal-entries" class="space-y-4"></div>
</div>
</div>

<!-- ===== PROFIL ===== -->
<div id="screen-profile" class="screen min-h-screen px-4 py-8">
<div class="max-w-3xl mx-auto">
<div class="bg-white/70 rounded-3xl p-8 shadow-xl border border-white/80 mb-6">
<div class="flex items-center gap-6 mb-6">
<div class="w-20 h-20 rounded-full bg-gradient-to-br from-purple-400 to-pink-400 flex items-center justify-center text-3xl shadow-lg">🌿</div>
<div><h1 class="text-2xl font-bold text-gray-800" id="profile-name">Toi</h1><p class="text-gray-500">Membre <span id="profile-plan">Gratuit</span></p></div>
</div>
<div class="grid grid-cols-3 gap-4 mb-6">
<div class="bg-purple-50 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-purple-700" id="p-exercises">0</p><p class="text-xs text-purple-600">Exercices</p></div>
<div class="bg-pink-50 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-pink-700" id="p-streak">0</p><p class="text-xs text-pink-600">Jours d'affilée</p></div>
<div class="bg-amber-50 rounded-xl p-4 text-center"><p class="text-2xl font-bold text-amber-700" id="p-level">1</p><p class="text-xs text-amber-600">Niveau</p></div>
</div>
<!-- Badges -->
<h3 class="font-bold text-gray-800 mb-3">🏆 Mes badges</h3>
<div id="badges-container" class="flex flex-wrap gap-3 mb-6"></div>
<!-- Niveau -->
<div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-4 border border-purple-100">
<div class="flex justify-between items-center mb-2"><span class="font-semibold text-purple-800">Niveau <span id="level-num">1</span></span><span class="text-sm text-purple-600"><span id="xp-current">0</span>/<span id="xp-next">100</span> XP</span></div>
<div class="w-full h-3 bg-purple-200 rounded-full overflow-hidden"><div id="xp-bar" class="h-full bg-gradient-to-r from-purple-400 to-pink-400 rounded-full transition-all" style="width:0%"></div></div>
<p class="text-xs text-purple-500 mt-2">Continue à pratiquer pour monter de niveau !</p>
</div>
</div>
<button onclick="showScreen('screen-pricing')" class="w-full py-4 bg-gradient-to-r from-amber-400 to-orange-400 text-white rounded-xl font-bold text-lg shadow-lg hover:scale-105 transition-all mb-4">⭐ Passer Premium</button>
</div>
</div>

<!-- ===== TARIFICATION ===== -->
<div id="screen-pricing" class="screen min-h-screen px-4 py-8">
<div class="max-w-4xl mx-auto">
<button onclick="showScreen('screen-home')" class="flex items-center gap-2 text-gray-500 hover:text-purple-600 mb-6">← Retour</button>
<div class="text-center mb-10">
<div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-amber-200 to-orange-200 shadow-xl mb-6"><span class="text-4xl">⭐</span></div>
<h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-3">Passe au niveau supérieur</h1>
<p class="text-gray-600 text-lg">Débloque tout le potentiel d'Élan Vital</p>
</div>
<div class="grid md:grid-cols-2 gap-6 mb-10">
<!-- Gratuit -->
<div class="bg-white/70 rounded-3xl p-8 border-2 border-gray-200">
<div class="text-center mb-6"><h3 class="text-xl font-bold text-gray-800">Gratuit</h3><div class="mt-4"><span class="text-4xl font-bold">0€</span></div></div>
<ul class="space-y-3 mb-8 text-sm">
<li class="flex items-center gap-3 text-gray-700"><span class="text-green-500">✓</span>8 exercices de base</li>
<li class="flex items-center gap-3 text-gray-700"><span class="text-green-500">✓</span>Questionnaire personnalisé</li>
<li class="flex items-center gap-3 text-gray-700"><span class="text-green-500">✓</span>Journal basique</li>
<li class="flex items-center gap-3 text-gray-400"><span>✗</span>Programmes guidés</li>
<li class="flex items-center gap-3 text-gray-400"><span>✗</span>30+ exercices premium</li>
<li class="flex items-center gap-3 text-gray-400"><span>✗</span>Suivi de progression</li>
<li class="flex items-center gap-3 text-gray-400"><span>✗</span>Badges & récompenses</li>
<li class="flex items-center gap-3 text-gray-400"><span>✗</span>Défis quotidiens</li>
<li class="flex items-center gap-3 text-gray-400"><span>✗</span>Formations vidéo</li>
<li class="flex items-center gap-3 text-gray-400"><span>✗</span>Communauté privée</li>
</ul>
<button onclick="showScreen('screen-home')" class="w-full py-3 border-2 border-gray-300 text-gray-600 rounded-xl font-semibold">Plan actuel</button>
</div>
<!-- Premium -->
<div class="relative bg-gradient-to-br from-purple-500 to-pink-500 rounded-3xl p-8 text-white shadow-2xl">
<div class="absolute -top-3 right-6 bg-amber-400 text-amber-900 px-4 py-1 rounded-full text-xs font-bold">⭐ RECOMMANDÉ</div>
<div class="text-center mb-6"><h3 class="text-xl font-bold">Premium</h3><div class="mt-4"><span class="text-4xl font-bold">9,90€</span><span class="text-purple-200">/mois</span></div><p class="text-purple-200 text-xs mt-2">ou 97€/an (2 mois offerts)</p></div>
<ul class="space-y-3 mb-8 text-sm">
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>30+ exercices</strong> complets</li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Programmes guidés</strong> (7, 21, 30 jours)</li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Suivi de progression</strong> complet</li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Badges & niveaux</strong></li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Défis quotidiens</strong></li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Journal avancé</strong> avec humeur</li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Nouveautés</strong> chaque mois</li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Formations vidéo</strong> exclusives</li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Ateliers créatifs</strong> guidés</li>
<li class="flex items-center gap-3"><span class="text-amber-300">✓</span><strong>Communauté privée</strong></li>
</ul>
<a href="#" class="block w-full py-4 bg-white text-purple-600 rounded-xl font-bold text-lg hover:scale-105 transition-transform shadow-lg text-center">Je passe Premium ✨</a>
<p class="text-center text-purple-200 text-xs mt-3">Paiement sécurisé • Annulation à tout moment</p>
</div>
</div>
<!-- Garanties -->
<div class="bg-white/70 rounded-3xl p-8 border border-white/80">
<h3 class="text-xl font-bold text-gray-800 mb-6 text-center">💜 Nos garanties</h3>
<div class="grid md:grid-cols-3 gap-6">
