// ===== ÉTAT =====
let curQ=0,answers=[],selVal=null;
let state=JSON.parse(localStorage.getItem('elanvital')||'{}');
if(!state.exercisesDone)state.exercisesDone=0;
if(!state.streak)state.streak=0;
if(!state.xp)state.xp=0;
if(!state.level)state.level=1;
if(!state.badges)state.badges=[];
if(!state.journal)state.journal=[];
if(!state.completedExercises)state.completedExercises=[];
if(!state.programProgress)state.programProgress={};
if(!state.lastDate)state.lastDate='';
saveState();

function saveState(){localStorage.setItem('elanvital',JSON.stringify(state))}

// ===== NAVIGATION =====
function showScreen(id){
document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
document.getElementById(id).classList.add('active');
window.scrollTo(0,0);
const showNav=['screen-home','screen-programs','screen-library','screen-journal','screen-profile'];
document.getElementById('bottom-nav').classList.toggle('hidden',!showNav.includes(id));
document.querySelectorAll('.nav-btn').forEach(b=>{
b.classList.toggle('text-purple-600',b.dataset.screen===id);
b.classList.toggle('text-gray-400',b.dataset.screen!==id);
});
if(id==='screen-home')renderHome();
if(id==='screen-library')showExercises();
if(id==='screen-programs')renderPrograms();
if(id==='screen-journal')renderJournal();
if(id==='screen-profile')renderProfile();
if(id==='screen-questionnaire'){curQ=0;answers=[];showQ();}
checkStreak();
}

// ===== QUESTIONNAIRE =====
function showQ(){
const q=questions[curQ];
document.getElementById('q-title').textContent=q.title;
document.getElementById('q-subtitle').textContent=q.subtitle;
document.getElementById('q-current').textContent=curQ+1;
document.getElementById('q-percent').textContent=Math.round(((curQ+1)/questions.length)*100);
document.getElementById('q-progress').style.width=((curQ+1)/questions.length)*100+'%';
const od=document.getElementById('q-options');od.innerHTML='';
q.options.forEach(o=>{const b=document.createElement('button');b.className='w-full text-left p-4 rounded-2xl border-2 border-gray-200 bg-white/50 hover:border-purple-200 transition-all';b.innerHTML='<div class="flex items-center gap-4"><span class="text-2xl">'+o.emoji+'</span><span class="text-gray-700">'+o.label+'</span></div>';b.onclick=()=>{selVal=o.value;document.querySelectorAll('#q-options button').forEach(x=>x.className='w-full text-left p-4 rounded-2xl border-2 border-gray-200 bg-white/50 transition-all');b.className='w-full text-left p-4 rounded-2xl border-2 border-purple-400 bg-purple-50 shadow-md transition-all';document.getElementById('q-next').disabled=false};od.appendChild(b)});
document.getElementById('q-back').disabled=curQ===0;
document.getElementById('q-next').disabled=true;selVal=null;
}
function nextQuestion(){if(selVal){answers[curQ]=selVal;if(curQ<questions.length-1){curQ++;showQ()}else showScreen('screen-home')}}
function prevQuestion(){if(curQ>0){curQ--;showQ()}}

// ===== ACCUEIL =====
function renderHome(){
document.getElementById('streak-count').textContent=state.streak;
document.getElementById('exercises-done').textContent=state.exercisesDone;
document.getElementById('level-display').textContent=state.level;
// Défi du jour
const dayIndex=new Date().getDate()%dailyChallenges.length;
document.getElementById('daily-challenge').textContent=dailyChallenges[dayIndex];
// Exercice recommandé
const free=exercises.filter(e=>!e.premium);
const rec=free[Math.floor(Math.random()*free.length)];
document.getElementById('recommended-exercise').innerHTML='<div class="flex items-center gap-4" onclick="showExercise(\''+rec.id+'\')"><span class="text-3xl">'+rec.emoji+'</span><div class="flex-1"><h3 class="font-semibold text-gray-800">'+rec.title+'</h3><p class="text-gray-500 text-sm">'+rec.desc+'</p></div><span class="text-purple-400">→</span></div>';
// Programmes
const hp=document.getElementById('home-programs');hp.innerHTML='';
programs.filter(p=>!p.premium).slice(0,2).forEach(p=>{
hp.innerHTML+='<button onclick="showProgramDetail(\''+p.id+'\')" class="text-left bg-gradient-to-r '+p.color+' rounded-xl p-4 text-white hover:shadow-lg transition-all"><h4 class="font-bold mb-1">'+p.title+'</h4><p class="text-sm opacity-90">'+p.duration+'</p></button>';
});
}

// ===== EXERCICES =====
function showExercises(filter){
const g=document.getElementById('exercises-grid');g.innerHTML='';
const list=filter&&filter!=='all'?exercises.filter(e=>e.cat===filter):exercises;
list.forEach(e=>{
const done=state.completedExercises.includes(e.id);
const c=document.createElement('button');
c.className='group text-left bg-white/70 rounded-2xl p-6 shadow-md border border-white/80 hover:shadow-xl hover:border-purple-200 transition-all relative';
c.innerHTML='<div class="flex items-start justify-between mb-4"><span class="text-4xl">'+e.emoji+'</span><div class="flex flex-col items-end gap-1">'+(e.premium?'<span class="badge bg-gradient-to-r from-amber-400 to-orange-400 text-white">⭐ PREMIUM</span>':'<span class="badge bg-green-100 text-green-700">Gratuit</span>')+(done?'<span class="badge bg-green-500 text-white">✓ Fait</span>':'')+'</div></div><h3 class="font-bold text-gray-800 text-lg mb-2">'+e.title+'</h3><p class="text-gray-500 text-sm mb-4 line-clamp-2">'+e.desc+'</p><div class="flex items-center gap-3"><span class="text-xs px-2 py-1 bg-gray-100 text-gray-600 rounded-full">⏱️ '+e.duration+'</span><span class="text-xs px-2 py-1 bg-gray-100 text-gray-600 rounded-full">📊 '+e.diff+'</span>'+(e.premium&&!state.isPremium?'<span class="text-lg ml-auto">🔒</span>':'')+'</div>';
c.onclick=()=>{if(e.premium&&!state.isPremium)showScreen('screen-pricing');else showExercise(e.id)};
g.appendChild(c);
});
}
function filterExercises(cat){
document.querySelectorAll('.filter-btn').forEach(b=>{b.className='filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-white/70 text-gray-600 border border-gray-200'});
event.target.className='filter-btn px-4 py-2 rounded-xl text-sm font-medium bg-purple-500 text-white';
showExercises(cat);
}

function showExercise(id){
const e=exercises.find(x=>x.id===id);if(!e)return;
document.getElementById('exercise-content').innerHTML='<div class="flex items-start gap-4 mb-6"><span class="text-5xl">'+e.emoji+'</span><div><h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">'+e.title+'</h1><div class="flex items-center gap-3"><span class="text-sm text-gray-500">⏱️ '+e.duration+'</span><span class="text-sm text-gray-500">📊 '+e.diff+'</span></div></div></div><p class="text-gray-600 text-lg mb-6">'+e.desc+'</p><div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-2xl p-5 border border-purple-100"><h3 class="font-semibold text-purple-800 mb-3">✨ Bienfaits</h3><div class="flex flex-wrap gap-2">'+e.benefits.map(b=>'<span class="px-3 py-1.5 bg-white/80 rounded-full text-sm text-purple-700 border border-purple-100">'+b+'</span>').join('')+'</div></div>';
const sd=document.getElementById('exercise-steps');sd.innerHTML='<h2 class="text-xl font-bold text-gray-800 mb-4">📋 Les étapes</h2>';
e.steps.forEach((s,i)=>{const d=document.createElement('div');d.className='bg-white/70 rounded-2xl p-6 border border-gray-200 slide-up';d.style.animationDelay=(i*0.1)+'s';d.innerHTML='<div class="flex items-start gap-4"><div class="flex-shrink-0 w-10 h-10 rounded-full bg-purple-500 text-white flex items-center justify-center font-bold">'+(i+1)+'</div><div><h3 class="font-bold text-lg text-gray-800 mb-2">'+s.t+'</h3><p class="text-gray-600">'+s.d+'</p></div></div>';sd.appendChild(d)});
document.getElementById('complete-btn').style.display=state.completedExercises.includes(id)?'none':'block';
document.getElementById('complete-btn').onclick=()=>completeExercise(id);
showScreen('screen-exercise');
}

function completeExercise(id){
if(!state.completedExercises.includes(id)){
state.completedExercises.push(id);
state.exercisesDone++;
state.xp+=20;
checkLevelUp();
checkBadges();
saveState();
}
showScreen('screen-library');
}

function completeDailyChallenge(){
state.xp+=10;state.streak++;state.lastDate=new Date().toDateString();
checkLevelUp();saveState();renderHome();
alert('🔥 Bravo ! Défi accompli ! +10 XP');
}

function checkLevelUp(){
const xpNeeded=state.level*100;
while(state.xp>=xpNeeded){state.xp-=xpNeeded;state.level++}
}

function checkBadges(){
allBadges.forEach(b=>{
if(!state.badges.includes(b.id)){
let earned=false;
if(b.id==='b1'&&state.exercisesDone>=1)earned=true;
if(b.id==='b2'&&state.streak>=3)earned=true;
if(b.id==='b3'&&state.streak>=7)earned=true;
if(b.id==='b4'&&state.exercisesDone>=10)earned=true;
if(b.id==='b8'&&state.level>=5)earned=true;
if(earned){state.badges.push(b.id);alert('🏆 Nouveau badge : '+b.emoji+' '+b.name+' !')}
}
});
}

function checkStreak(){
const today=new Date().toDateString();
if(state.lastDate&&state.lastDate!==today){
const last=new Date(state.lastDate);
const diff=Math.floor((new Date()-last)/(1000*60*60*24));
if(diff>1)state.streak=0;
saveState();
}
}

// ===== PROGRAMMES =====
function renderPrograms(){
const pl=document.getElementById('programs-list');pl.innerHTML='';
programs.forEach(p=>{
const progress=state.programProgress[p.id]||0;
const pct=Math.round((progress/p.days.length)*100);
pl.innerHTML+='<div class="bg-white/70 rounded-2xl p-6 border border-white/80 shadow-lg hover:shadow-xl transition-all cursor-pointer" onclick="showProgramDetail(\''+p.id+'\')"><div class="flex items-start gap-4"><div class="w-14 h-14 rounded-xl bg-gradient-to-br '+p.color+' flex items-center justify-center text-2xl shadow-lg">'+p.title.split(' ')[0]+'</div><div class="flex-1"><div class="flex items-center gap-2 mb-1"><h3 class="font-bold text-gray-800 text-lg">'+p.title.substring(p.title.indexOf(' ')+1)+'</h3>'+(p.premium?'<span class="badge bg-gradient-to-r from-amber-400 to-orange-400 text-white">⭐ PREMIUM</span>':'')+'</div><p class="text-gray-500 text-sm mb-3">'+p.desc+'</p><div class="flex items-center gap-3"><span class="text-xs text-gray-500">📅 '+p.duration+'</span><span class="text-xs text-gray-500">'+p.days.length+' étapes</span></div><div class="mt-3"><div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden"><div class="h-full bg-gradient-to-r '+p.color+' rounded-full" style="width:'+pct+'%"></div></div><p class="text-xs text-gray-500 mt-1">'+progress+'/'+p.days.length+' complétés</p></div></div><span class="text-purple-400 text-xl">→</span></div></div>';
});
}

function showProgramDetail(id){
const p=programs.find(x=>x.id===id);if(!p)return;
if(p.premium&&!state.isPremium){showScreen('screen-pricing');return}
const progress=state.programProgress[p.id]||0;
const cd=document.getElementById('program-detail-content');
cd.innerHTML='<div class="bg-gradient-to-r '+p.color+' rounded-3xl p-8 text-white shadow-xl mb-8"><h1 class="text-2xl md:text-3xl font-bold mb-2">'+p.title+'</h1><p class="opacity-90 mb-4">'+p.desc+'</p><p class="text-sm opacity-80">📅 '+p.duration+' • '+p.days.length+' étapes</p></div><div class="space-y-3">';
p.days.forEach((d,i)=>{
const done=i<progress;
cd.innerHTML+='<div class="bg-white/70 rounded-xl p-4 border border-white/80 flex items-center gap-4 '+(done?'opacity-70':'')+'"><div class="w-10 h-10 rounded-full flex items-center justify-center font-bold text-sm '+(done?'bg-green-500 text-white':'bg-gray-200 text-gray-500')+'">'+(done?'✓':(i+1))+'</div><div class="flex-1"><h4 class="font-semibold text-gray-800">'+d.t+'</h4><p class="text-gray-600 text-sm">'+d.d+'</p></div>'+(i===progress?'<button onclick="advanceProgram(\''+p.id+'\')" class="px-4 py-2 bg-gradient-to-r '+p.color+' text-white rounded-lg text-sm font-semibold hover:scale-105 transition-all">Fait ✓</button>':'')+'</div>';
});
cd.innerHTML+='</div>';
showScreen('screen-program-detail');
}

function advanceProgram(id){
if(!state.programProgress[id])state.programProgress[id]=0;
state.programProgress[id]++;
state.xp+=15;
checkLevelUp();saveState();
showProgramDetail(id);
}

// ===== JOURNAL =====
function renderJournal(){
const je=document.getElementById('journal-entries');je.innerHTML='';
if(state.journal.length===0){je.innerHTML='<p class="text-gray-400 text-center py-8">Ton journal est vide. Commence à écrire ! 🌿</p>';return}
state.journal.slice().reverse().forEach((entry,i)=>{
je.innerHTML+='<div class="bg-white/70 rounded-xl p-4 border border-white/80"><div class="flex items-center gap-2 mb-2"><span class="text-lg">'+(entry.mood||'📝')+'</span><span class="text-xs text-gray-400">'+entry.date+'</span></div><p class="text-gray-700 text-sm">'+entry.text+'</p></div>';
});
}

function saveJournalEntry(){
const text=document.getElementById('journal-input').value.trim();
if(!text)return;
const mood=document.getElementById('journal-mood').value;
state.journal.push({text:text,mood:mood,date:new Date().toLocaleDateString('fr-FR')});
state.xp+=5;saveState();
document.getElementById('journal-input').value='';
document.getElementById('journal-mood').value='';
renderJournal();
}

// ===== PROFIL =====
function renderProfile(){
document.getElementById('p-exercises').textContent=state.exercisesDone;
document.getElementById('p-streak').textContent=state.streak;
document.getElementById('p-level').textContent=state.level;
document.getElementById('level-num').textContent=state.level;
document.getElementById('xp-current').textContent=state.xp;
const xpNeeded=state.level*100;
document.getElementById('xp-next').textContent=xpNeeded;
document.getElementById('xp-bar').style.width=(state.xp/xpNeeded*100)+'%';
document.getElementById('profile-plan').textContent=state.isPremium?'Premium ⭐':'Gratuit';
// Badges
const bc=document.getElementById('badges-container');bc.innerHTML='';
allBadges.forEach(b=>{
const earned=state.badges.includes(b.id);
bc.innerHTML+='<div class="flex items-center gap-2 px-3 py-2 rounded-xl '+(earned?'bg-amber-50 border border-amber-200':'bg-gray-100 border border-gray-200 opacity-50')+'" title="'+b.desc+'"><span class="text-xl">'+b.emoji+'</span><span class="text-xs font-medium '+(earned?'text-amber-800':'text-gray-400')+'">'+b.name+'</span></div>';
});
}
</script>
</body>
</html>


+++ index.html (修改后)
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Élan Vital - Bien-être & Développement personnel</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.05)}}
@keyframes flip{0%{transform:rotateY(0)}100%{transform:rotateY(180deg)}}
@keyframes glow{0%,100%{box-shadow:0 0 5px rgba(139,92,246,0.3)}50%{box-shadow:0 0 20px rgba(139,92,246,0.6)}}
.fade-in{animation:fadeIn .5s ease-out}
.pulse-anim{animation:pulse 2s ease-in-out infinite}
.glow-anim{animation:glow 2s ease-in-out infinite}
.screen{display:none}.screen.active{display:block}
.card-flip{perspective:1000px}
.card-inner{transition:transform 0.6s;transform-style:preserve-3d;position:relative}
.card-inner.flipped{transform:rotateY(180deg)}
.card-front,.card-back{backface-visibility:hidden;position:absolute;top:0;left:0;width:100%;height:100%}
.card-back{transform:rotateY(180deg)}
</style>
</head>
<body class="bg-gradient-to-br from-purple-50 via-blue-50 to-pink-50 min-h-screen">

<!-- NAVIGATION BOTTOM -->
<nav id="bottom-nav" class="fixed bottom-0 left-0 right-0 bg-white/90 backdrop-blur-lg border-t border-purple-100 z-50 hidden">
<div class="max-w-lg mx-auto flex justify-around py-2">
<button onclick="showScreen('screen-home')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400" data-screen="screen-home"><span class="text-xl">🏠</span><span class="text-xs">Accueil</span></button>
<button onclick="showScreen('screen-card')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400" data-screen="screen-card"><span class="text-xl">🎴</span><span class="text-xs">Carte</span></button>
<button onclick="showScreen('screen-programs')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400" data-screen="screen-programs"><span class="text-xl">📅</span><span class="text-xs">100 jours</span></button>
<button onclick="showScreen('screen-library')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400" data-screen="screen-library"><span class="text-xl">📚</span><span class="text-xs">Exercices</span></button>
<button onclick="showScreen('screen-profile')" class="nav-btn flex flex-col items-center gap-1 p-2 rounded-xl text-gray-400" data-screen="screen-profile"><span class="text-xl">👤</span><span class="text-xs">Profil</span></button>
</div>
</nav>

<div id="app" class="pb-20">

<!-- ===== ACCUEIL ===== -->
<div id="screen-welcome" class="screen active min-h-screen flex flex-col items-center justify-center px-4 py-12">
<div class="max-w-2xl mx-auto text-center">
<div class="mb-8">
<div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-br from-purple-200 to-pink-200 shadow-xl mb-6 pulse-anim"><span class="text-5xl">🌿</span></div>
<h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-purple-700 via-pink-600 to-amber-600 bg-clip-text text-transparent mb-2">Élan Vital</h1>
<p class="text-lg text-gray-500">Bien-être • Créativité • Transformation</p>
</div>
<div class="bg-white/60 rounded-3xl p-8 shadow-xl border border-white/80 mb-8">
<p class="text-xl text-gray-700 mb-6">Bienvenue, toi. ✨</p>
<p class="text-gray-600 mb-4">Un parcours de <strong class="text-purple-700">100 jours</strong> pour te reconnecter à toi-même, libérer ta créativité et transformer ta vie.</p>
<div class="grid grid-cols-2 gap-3 my-6">
<div class="bg-purple-50 rounded-xl p-3 border border-purple-100"><span class="text-lg">📅</span><p class="text-xs text-purple-700 mt-1">100 jours de transformation</p></div>
<div class="bg-pink-50 rounded-xl p-3 border border-pink-100"><span class="text-lg">🎴</span><p class="text-xs text-pink-700 mt-1">Carte du jour</p></div>
<div class="bg-amber-50 rounded-xl p-3 border border-amber-100"><span class="text-lg">✍️</span><p class="text-xs text-amber-700 mt-1">Écriture créative</p></div>
<div class="bg-green-50 rounded-xl p-3 border border-green-100"><span class="text-lg">🎨</span><p class="text-xs text-green-700 mt-1">Création & transformation</p></div>
</div>
<div class="bg-gradient-to-r from-purple-100 to-pink-100 rounded-2xl p-4 mb-6">
<p class="text-purple-800 text-sm font-medium">🌟 50+ exercices • Rituels matin/soir • Défis créatifs • Histoires à écrire • Créations à transformer</p>
</div>
</div>
<button onclick="showScreen('screen-questionnaire')" class="px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-2xl font-semibold text-lg shadow-xl hover:scale-105 transition-all">Commencer mon parcours →</button>
</div>
</div>

<!-- ===== QUESTIONNAIRE ===== -->
<div id="screen-questionnaire" class="screen min-h-screen flex flex-col items-center justify-center px-4 py-12">
<div class="max-w-2xl mx-auto w-full">
<div class="mb-8">
<div class="flex items-center justify-between mb-2"><span class="text-sm text-gray-500">Question <span id="q-current">1</span> sur 5</span><span class="text-sm text-purple-600 font-medium"><span id="q-percent">20</span>%</span></div>
<div class="w-full h-2 bg-purple-100 rounded-full overflow-hidden"><div id="q-progress" class="h-full bg-gradient-to-r from-purple-400 to-pink-400 rounded-full transition-all duration-500" style="width:20%"></div></div>
</div>
<div class="bg-white/70 rounded-3xl p-8 shadow-xl border border-white/80">
<h2 id="q-title" class="text-2xl font-bold text-gray-800 mb-3"></h2>
<p id="q-subtitle" class="text-gray-500 text-lg italic mb-8"></p>
<div id="q-options" class="space-y-3 mb-8"></div>
<div class="flex items-center justify-between">
<button id="q-back" onclick="prevQuestion()" class="px-5 py-3 text-gray-500" disabled>← Retour</button>
<button id="q-next" onclick="nextQuestion()" class="px-8 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-xl font-semibold shadow-lg hover:scale-105 transition-all" disabled>Suivant →</button>
</div>
</div>
</div>
</div>

<!-- ===== PAGE D'ACCUEIL ===== -->
<div id="screen-home" class="screen min-h-screen px-4 py-6">
<div class="max-w-4xl mx-auto">
<!-- Salutation -->
<div class="bg-gradient-to-r from-purple-500 to-pink-500 rounded-3xl p-6 text-white shadow-xl mb-6">
<h1 class="text-xl md:text-2xl font-bold mb-2" id="greeting">Bonjour toi ! 🌿</h1>
<p class="text-purple-100 text-sm mb-4">Jour <span id="current-day">1</span>/100 de ton parcours</p>
<div class="flex items-center gap-3">
<div class="bg-white/20 rounded-xl px-3 py-2"><span class="text-xl font-bold" id="streak-count">0</span><p class="text-xs text-purple-100">jours 🔥</p></div>
<div class="bg-white/20 rounded-xl px-3 py-2"><span class="text-xl font-bold" id="exercises-done">0</span><p class="text-xs text-purple-100">exercices ✨</p></div>
<div class="bg-white/20 rounded-xl px-3 py-2"><span class="text-xl font-bold" id="level-display">1</span><p class="text-xs text-purple-100">niveau 🏆</p></div>
</div>
</div>

<!-- Carte du jour -->
<div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-2xl p-5 border border-amber-200 mb-6 cursor-pointer hover:shadow-lg transition-all" onclick="showScreen('screen-card')">
<div class="flex items-center gap-3"><span class="text-2xl">🎴</span><div><h3 class="font-bold text-amber-800">Ta carte du jour</h3><p class="text-amber-600 text-sm">Tire ta carte pour découvrir ton intention du jour</p></div><span class="ml-auto text-amber-400">→</span></div>
</div>

<!-- Rituel du moment -->
<div id="ritual-section" class="bg-white/70 rounded-2xl p-5 border border-white/80 shadow-lg mb-6">
<h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2"><span id="ritual-icon">🌅</span><span id="ritual-title">Rituel du matin</span></h3>
<div id="ritual-content" class="space-y-3"></div>
</div>

<!-- Défi de la semaine -->
<div class="bg-gradient-to-r from-pink-50 to-rose-50 rounded-2xl p-5 border border-pink-200 mb-6">
<div class="flex items-center gap-3 mb-3"><span class="text-2xl">🎭</span><h3 class="font-bold text-pink-800">Défi créatif de la semaine</h3></div>
<p id="weekly-challenge" class="text-pink-700 mb-3"></p>
<button onclick="completeWeeklyChallenge()" class="px-4 py-2 bg-pink-500 text-white rounded-lg text-sm font-semibold hover:bg-pink-600 transition-colors">✓ Défi accompli !</button>
</div>

<!-- Phase en cours -->
<div class="bg-white/70 rounded-2xl p-5 border border-white/80 shadow-lg mb-6">
<h3 class="font-bold text-gray-800 mb-3 flex items-center gap-2"><span>📅</span> Ta phase actuelle</h3>
<div id="current-phase" class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-4 border border-purple-100"></div>
</div>

