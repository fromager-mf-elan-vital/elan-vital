{title:"Qu'est-ce qui t'attire le plus ?",subtitle:"Choisis ce qui te parle.",options:[{value:'respirer',label:'Respirer, méditer',emoji:'🧘'},{value:'bouger',label:'Bouger, nature',emoji:'🌿'},{value:'creer',label:'Créer, dessiner',emoji:'🎨'},{value:'ecrire',label:'Écrire, réfléchir',emoji:'📝'},{value:'visualiser',label:'Visualiser mes objectifs',emoji:'🎯'},{value:'nature',label:'Être en nature',emoji:'🌳'}]},
{title:"Quelle est ton intention ?",subtitle:"Ton intention guide ton chemin.",options:[{value:'apaiser',label:'Apaiser mon mental',emoji:'🌙'},{value:'grandir',label:'Grandir et évoluer',emoji:'🌱'},{value:'confiance',label:'Renforcer ma confiance',emoji:'💎'},{value:'creativite',label:'Éveiller ma créativité',emoji:'✨'},{value:'presence',label:'Vivre le présent',emoji:'🌻'},{value:'harmonie',label:"L'harmonie intérieure",emoji:'☯️'}]}
];

const exercises=[
{id:'med-1',title:'Respiration consciente',cat:'meditation',duration:'5-10 min',diff:'débutant',emoji:'🌬️',premium:false,desc:'Une méditation simple centrée sur le souffle.',benefits:['Réduit le stress','Améliore la concentration','Calme le système nerveux'],steps:[{t:'Installe-toi',d:'Assieds-toi confortablement. Ferme les yeux.'},{t:'Observe ta respiration',d:'Observe simplement comment tu respires.'},{t:'Approfondis',d:'Inspire 4 secondes, retiens 2 secondes, expire 6 secondes.'},{t:'Continue',d:'Pendant 5-10 minutes. Ramène ton esprit au souffle.'},{t:'Reviens',d:'Ouvre les yeux doucement.'}]},
{id:'med-2',title:'Scan corporel',cat:'meditation',duration:'15-20 min',diff:'intermédiaire',emoji:'🫧',premium:true,desc:'Un voyage doux à travers ton corps.',benefits:['Relâche les tensions','Favorise le sommeil','Conscience de soi'],steps:[{t:'Allonge-toi',d:'Confortablement, bras le long du corps.'},{t:'Respire',d:'3 grandes respirations profondes.'},{t:'Les pieds',d:'Porte ton attention sur tes pieds.'},{t:'Remonte',d:'Jambes, hanches, ventre, poitrine...'}, {t:'Enveloppe-toi',d:'Imagine une lumière chaude.'}]},
{id:'med-3',title:'Méditation gratitude',cat:'meditation',duration:'10 min',diff:'débutant',emoji:'🙏',premium:false,desc:'Cultive la gratitude.',benefits:['Améliore l\'humeur','Renforce la résilience','Favorise l\'optimisme'],steps:[{t:'Installe-toi',d:'Trouve un endroit paisible.'},{t:'3 choses',d:'Identifie 3 choses pour lesquelles tu es reconnaissant·e.'},{t:'Ressens',d:'Pour chaque chose, ressens la gratitude.'},{t:'Toi-même',d:'Envoie de la gratitude envers toi.'},{t:'Clôture',d:'Main sur le cœur. Respire.'}]},
{id:'anc-1',title:'L\'arbre intérieur',cat:'ancrage',duration:'10 min',diff:'débutant',emoji:'🌳',premium:false,desc:'Visualise-toi comme un arbre puissant.',benefits:['Stabilité','Confiance','Connexion nature'],steps:[{t:'Debout',d:'Pieds écartés, ancrés dans le sol.'},{t:'Racines',d:'Visualise des racines profondes.'},{t:'Tronc fort',d:'Ton corps est un tronc solide.'},{t:'Branches',d:'Tes bras s\'ouvrent vers le ciel.'},{t:'Reviens',d:'Grande inspiration. Ramène cette force.'}]},
{id:'anc-2',title:'Les 5 sens',cat:'ancrage',duration:'5 min',diff:'débutant',emoji:'👁️',premium:false,desc:'Reconnecte-toi au moment présent.',benefits:['Stoppe l\'anxiété','Ramène au présent','Disponible partout'],steps:[{t:'5 VOIS',d:'Nomme 5 choses que tu vois.'},{t:'4 TOUCHES',d:'Sens 4 choses que tu touches.'},{t:'3 ENTENDS',d:'Identifie 3 sons.'},{t:'2 SENS',d:'Identifie 2 odeurs.'},{t:'1 GOÛTE',d:'Concentre-toi sur le goût.'}]},
{id:'art-1',title:'Dessin intuitif',cat:'art-therapie',duration:'15-20 min',diff:'débutant',emoji:'🎨',premium:false,desc:'Exprime-toi par les couleurs et formes.',benefits:['Libère la créativité','Conscience de soi','Réduit le stress'],steps:[{t:'Prépare',d:'Papier et crayons de couleur.'},{t:'Connecte-toi',d:'Comment te sens-tu ?'}, {t:'Laisse-toi guider',d:'Laisse ta main bouger.'},{t:'Couleurs',d:'Choisis celles qui t\'attirent.'},{t:'Contemple',d:'Que te dit ton dessin ?'}]},
{id:'art-2',title:'Mandala personnel',cat:'art-therapie',duration:'20-30 min',diff:'intermédiaire',emoji:'🔮',premium:true,desc:'Crée ton mandala pour te centrer.',benefits:['Centre et recentre','Méditation','Harmonise'],steps:[{t:'Cercle',d:'Dessine un grand cercle.'},{t:'Centre',d:'Dessine ce qui te représente.'},{t:'Couches',d:'Ajoute des formes concentriques.'},{t:'Couleurs',d:'Utilise celles qui te parlent.'},{t:'Contemple',d:'Regarde ton mandala.'}]},
{id:'emo-1',title:'Journal de gratitude',cat:'emotionnel',duration:'5-10 min',diff:'débutant',emoji:'📔',premium:false,desc:'Note 3 gratitudes chaque jour.',benefits:['Recentre sur le positif','Améliore l\'humeur','Change la perspective'],steps:[{t:'Moment',d:'Matin ou soir, un moment calme.'},{t:'3 gratitudes',d:'Note 3 choses simples.'},{t:'Développe',d:'Écris pourquoi.'},{t:'Toi-même',d:'Une gratitude envers toi.'},{t:'Ressens',d:'Laisse monter le sentiment.'}]},
{id:'emo-2',title:'Lettre à soi-même',cat:'emotionnel',duration:'15-20 min',diff:'intermédiaire',emoji:'💌',premium:true,desc:'Écris une lettre tendre à toi-même.',benefits:['Compassion','Estime de soi','Lien intérieur'],steps:[{t:'Installe-toi',d:'Endroit calme.'},{t:'Commence',d:'"Cher moi," ou "À moi-même,"'},{t:'Parcours',d:'Ce que tu as accompli.'},{t:'Compassion',d:'Mots de tendresse.'},{t:'Amour',d:'"Je suis là pour toi."'}]},
{id:'emo-3',title:'Valeurs personnelles',cat:'emotionnel',duration:'20-30 min',diff:'intermédiaire',emoji:'💎',premium:true,desc:'Découvre tes valeurs fondamentales.',benefits:['Clarifie les choix','Donne du sens','Guide les décisions'],steps:[{t:'Fierté',d:'5 moments de fierté.'},{t:'Thèmes',d:'Quels thèmes reviennent ?'},{t:'5 valeurs',d:'Choisis les 5 qui résonnent.'},{t:'Définis',d:'Ce que chacune signifie.'},{t:'Alignement',d:'Ta vie reflète-t-elle ces valeurs ?'}]}
];

let curQ=0,answers=[],selVal=null;

function showScreen(id){
document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
document.getElementById(id).classList.add('active');
window.scrollTo(0,0);
if(id==='screen-questionnaire'){curQ=0;answers=[];showQ()}
else if(id==='screen-results')showResults();
else if(id==='screen-library')showExercises();
}

function showQ(){
const q=questions[curQ];
document.getElementById('q-title').textContent=q.title;
document.getElementById('q-subtitle').textContent=q.subtitle;
document.getElementById('q-current').textContent=curQ+1;
document.getElementById('q-percent').textContent=Math.round(((curQ+1)/questions.length)*100);
document.getElementById('q-progress').style.width=((curQ+1)/questions.length)*100+'%';
const od=document.getElementById('q-options');
od.innerHTML='';
q.options.forEach(o=>{
const b=document.createElement('button');
b.className='w-full text-left p-4 rounded-2xl border-2 border-gray-200 bg-white/50 hover:border-purple-200 hover:bg-purple-50/50 transition-all';
b.innerHTML='<div class="flex items-center gap-4"><span class="text-2xl">'+o.emoji+'</span><span class="text-gray-700">'+o.label+'</span></div>';
b.onclick=()=>{selVal=o.value;document.querySelectorAll('#q-options button').forEach(x=>x.className='w-full text-left p-4 rounded-2xl border-2 border-gray-200 bg-white/50 hover:border-purple-200 hover:bg-purple-50/50 transition-all');b.className='w-full text-left p-4 rounded-2xl border-2 border-purple-400 bg-purple-50 shadow-md transition-all';document.getElementById('q-next').disabled=false};
od.appendChild(b);
});
document.getElementById('q-back').disabled=curQ===0;
document.getElementById('q-next').disabled=true;
selVal=null;
}

function nextQuestion(){if(selVal){answers[curQ]=selVal;if(curQ<questions.length-1){curQ++;showQ()}else showScreen('screen-results')}}
function prevQuestion(){if(curQ>0){curQ--;showQ()}}

function showResults(){
const rd=document.getElementById('r-recommendations');
const fe=exercises.filter(e=>!e.premium).slice(0,3);
let h='<h2 class="text-2xl font-bold text-gray-800 mb-4">✨ Exercices recommandés</h2><div class="space-y-3">';
fe.forEach(e=>{h+='<button onclick="showExercise(\''+e.id+'\')" class="w-full text-left p-5 rounded-2xl bg-gradient-to-r from-purple-50 to-pink-50 border border-purple-200/50 hover:shadow-lg transition-all"><div class="flex items-center gap-4"><span class="text-3xl">'+e.emoji+'</span><div class="flex-1"><h3 class="font-semibold text-gray-800 text-lg">'+e.title+'</h3><p class="text-gray-500 text-sm">'+e.desc+'</p><div class="flex items-center gap-3 mt-2"><span class="text-xs px-2 py-1 bg-purple-100 text-purple-700 rounded-full">⏱️ '+e.duration+'</span><span class="text-xs px-2 py-1 bg-green-100 text-green-700 rounded-full">📊 '+e.diff+'</span></div></div><span class="text-purple-400 text-xl">→</span></div></button>'});
h+='</div>';rd.innerHTML=h;
}

function showExercises(){
const g=document.getElementById('exercises-grid');g.innerHTML='';
exercises.forEach(e=>{
const c=document.createElement('button');
c.className='group text-left bg-white/70 rounded-2xl p-6 shadow-md border border-white/80 hover:shadow-xl hover:border-purple-200 transition-all';
c.innerHTML='<div class="flex items-start justify-between mb-4"><span class="text-4xl">'+e.emoji+'</span>'+(e.premium?'<span class="text-xs px-2 py-0.5 bg-gradient-to-r from-amber-400 to-orange-400 text-white rounded-full font-bold">⭐ PREMIUM</span>':'')+'</div><h3 class="font-bold text-gray-800 text-lg mb-2">'+e.title+'</h3><p class="text-gray-500 text-sm mb-4">'+e.desc+'</p><div class="flex items-center gap-3"><span class="text-xs px-2 py-1 bg-gray-100 text-gray-600 rounded-full">⏱️ '+e.duration+'</span><span class="text-xs px-2 py-1 bg-gray-100 text-gray-600 rounded-full">📊 '+e.diff+'</span>'+(e.premium?'<span class="text-lg ml-auto">🔒</span>':'')+'</div>';
c.onclick=()=>{if(e.premium)showScreen('screen-pricing');else showExercise(e.id)};
g.appendChild(c);
});
}

function showExercise(id){
const e=exercises.find(x=>x.id===id);if(!e)return;
document.getElementById('exercise-content').innerHTML='<div class="flex items-start gap-4 mb-6"><span class="text-5xl">'+e.emoji+'</span><div><h1 class="text-2xl md:text-3xl font-bold text-gray-800 mb-2">'+e.title+'</h1><div class="flex items-center gap-3"><span class="text-sm text-gray-500">⏱️ '+e.duration+'</span><span class="text-sm text-gray-500">📊 '+e.diff+'</span></div></div></div><p class="text-gray-600 text-lg mb-6">'+e.desc+'</p><div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-2xl p-5 border border-purple-100"><h3 class="font-semibold text-purple-800 mb-3">✨ Bienfaits</h3><div class="flex flex-wrap gap-2">'+e.benefits.map(b=>'<span class="px-3 py-1.5 bg-white/80 rounded-full text-sm text-purple-700 border border-purple-100">'+b+'</span>').join('')+'</div></div>';
const sd=document.getElementById('exercise-steps');
sd.innerHTML='<h2 class="text-xl font-bold text-gray-800 mb-4">📋 Les étapes</h2>';
e.steps.forEach((s,i)=>{const d=document.createElement('div');d.className='bg-white/70 rounded-2xl p-6 border border-gray-200';d.innerHTML='<div class="flex items-start gap-4"><div class="flex-shrink-0 w-10 h-10 rounded-full bg-purple-500 text-white flex items-center justify-center font-bold">'+(i+1)+'</div><div><h3 class="font-bold text-lg text-gray-800 mb-2">'+s.t+'</h3><p class="text-gray-600">'+s.d+'</p></div></div>';sd.appendChild(d)});
showScreen('screen-exercise');
}
</script>
</body>
</html>
