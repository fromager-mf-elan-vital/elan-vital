const creationPrompts=[
{id:'c1',title:'Avant/Après',emoji:'🔄',desc:'Crée une œuvre en 2 parties : ce que tu veux laisser et ce que tu veux devenir.',transform:'Une habitude ou un comportement',premium:false,steps:[{t:'Identifie',d:'Qu\'est-ce que tu veux transformer ?'},{t:'Avant',d:'Crée/dessine l\'état actuel.'},{t:'Après',d:'Crée/dessine l\'état désiré.'},{t:'Le geste',d:'Fais un geste symbolique pour marquer le passage.'}]},
{id:'c2',title:'L\'emotion en matière',emoji:'🎭',desc:'Donne forme à une émotion difficile.',transform:'Une émotion qui te pèse',premium:true,steps:[{t:'L\'émotion',d:'Quelle émotion veux-tu transformer ?'},{t:'La matière',d:'Choisis : papier, argile, tissu, objets...'},{t:'La forme',d:'Donne-lui une forme.'},{t:'La transformation',d:'Transforme cette forme en quelque chose de beau.'},{t:'Le message',d:'Que te dit cette création ?'}]},
{id:'c3',title:'La boussole',emoji:'🧭',desc:'Crée ta boussole intérieure.',transform:'Le manque de direction',premium:true,steps:[{t:'Le Nord',d:'Qu\'est-ce qui te guide ? (une valeur)'},{t:'Le Sud',d:'D\'où viens-tu ? (tes racines)'},{t:'L\'Est',d:'Vers quoi tu vas ? (ton rêve)'},{t:'L\'Ouest',d:'Ce que tu laisses derrière.'},{t:'Crée',d:'Fabrique ta boussole.'}]},
{id:'c4',title:'Le masque et la vérité',emoji:'🎭',desc:'Crée un masque et révèle ce qui est derrière.',transform:'Ce que tu caches au monde',premium:true,steps:[{t:'Le masque',d:'Qu\'est-ce que tu montres au monde ?'},{t:'Crée le masque',d:'Dessine/fabrique ce masque.'},{t:'La vérité',d:'Qu\'est-ce qui est derrière ?'},{t:'Révèle',d:'Crée ce qui est caché.'},{t:'Intègre',d:'Comment réunir les deux ?'}]},
{id:'c5',title:'L\'autel personnel',emoji:'🕯️',desc:'Crée un espace sacré avec des objets qui comptent.',transform:'Le manque de connexion à soi',premium:true,steps:[{t:'Choisis',d:'5-7 objets qui ont du sens pour toi.'},{t:'Dispose',d:'Crée ton autel.'},{t:'Chaque objet',d:'Pourquoi cet objet ? Que représente-t-il ?'},{t:'Rituel',d:'Crée un petit rituel pour cet espace.'}]},
{id:'c6',title:'Le pont vers l\'autre',emoji:'🌉',desc:'Crée quelque chose pour quelqu\'un qui compte.',transform:'Une relation à améliorer',premium:true,steps:[{t:'La personne',d:'À qui penses-tu ?'},{t:'Le message',d:'Que veux-tu lui dire ?'},{t:'La création',d:'Crée quelque chose pour elle/lui.'},{t:'Le geste',d:'Comment le lui offrir ?'}]},
{id:'c7',title:'L\'arbre des possibles',emoji:'🌳',desc:'Crée un arbre avec tes possibilités.',transform:'Le sentiment d\'être bloqué·e',premium:true,steps:[{t:'Le tronc',d:'Toi, ici et maintenant.'},{t:'Les branches',d:'Chaque branche = une possibilité.'},{t:'Les fruits',d:'Ce que chaque possibilité peut t\'apporter.'},{t:'Choisis',d:'Quelle branche t\'attire le plus ?'}]},
{id:'c8',title:'La lettre en images',emoji:'🖼️',desc:'Crée une lettre visuelle à ton toi du futur.',transform:'Le manque de vision',premium:true,steps:[{t:'Le futur',d:'Imagine-toi dans 1 an.'},{t:'Les images',d:'Collecte/dessine des images.'},{t:'Compose',d:'Crée ta lettre visuelle.'},{t:'Place-la',d:'Là où tu la verras chaque jour.'}]}
];

// ===== ÉTAT =====
let curQ=0,answers=[],selVal=null,currentExerciseId=null;
let S=JSON.parse(localStorage.getItem('ev')||'{}');
if(!S.done)S.done=0;if(!S.streak)S.streak=0;if(!S.xp)S.xp=0;if(!S.level)S.level=1;
if(!S.day)S.day=1;if(!S.completed)S.completed=[];if(!S.lastDate)S.lastDate='';
if(!S.cardFlipped)S.cardFlipped=false;if(!S.cardDate)S.cardDate='';
if(!S.weekDone)S.weekDone=false;save();

function save(){localStorage.setItem('ev',JSON.stringify(S))}

// ===== NAVIGATION =====
function showScreen(id){
document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
document.getElementById(id).classList.add('active');
window.scrollTo(0,0);
const nav=['screen-home','screen-card','screen-programs','screen-library','screen-profile'];
document.getElementById('bottom-nav').classList.toggle('hidden',!nav.includes(id));
document.querySelectorAll('.nav-btn').forEach(b=>{b.classList.toggle('text-purple-600',b.dataset.screen===id);b.classList.toggle('text-gray-400',b.dataset.screen!==id)});
if(id==='screen-home')renderHome();
if(id==='screen-library')showExercises();
if(id==='screen-programs')renderPhases();
if(id==='screen-profile')renderProfile();
if(id==='screen-card')renderCard();
if(id==='screen-writing')renderWriting();
if(id==='screen-creation')renderCreation();
if(id==='screen-questionnaire'){curQ=0;answers=[];showQ();}
}

// ===== QUESTIONNAIRE =====
function showQ(){
const q=questions[curQ];
document.getElementById('q-title').textContent=q.title;
document.getElementById('q-subtitle').textContent=q.subtitle;
document.getElementById('q-current').textContent=curQ+1;
document.getElementById('q-percent').textContent=Math.round(((curQ+1)/questions.length)*100);
document.getElementById('q-progress').style.width=((curQ+1)/questions.length)*100+'%';
const od=document.getElementById('q-options');od.innerHTML='';
q.options.forEach(o=>{const b=document.createElement('button');b.className='w-full text-left p-4 rounded-2xl border-2 border-gray-200 bg-white/50 hover:border-purple-200 transition-all';b.innerHTML='<div class="flex items-center gap-4"><span class="text-2xl">'+o.emoji+'</span><span class="text-gray-700">'+o.label+'</span></div>';b.onclick=()=>{selVal=o.value;document.querySelectorAll('#q-options button').forEach(x=>x.className='w-full text-left p-4 rounded-2xl border-2 border-gray-200 bg-white/50 transition-all');b.className='w-full text-left p-4 rounded-2xl border-2 border-purple-400 bg-purple-50 shadow-md transition-all';document.getElementById('q-next').disabled=false};od.appendChild(b)});
document.getElementById('q-back').disabled=curQ===0;document.getElementById('q-next').disabled=true;selVal=null;
}
function nextQuestion(){if(selVal){answers[curQ]=selVal;if(curQ<questions.length-1){curQ++;showQ()}else showScreen('screen-home')}}
function prevQuestion(){if(curQ>0){curQ--;showQ()}}

// ===== ACCUEIL =====
function renderHome(){
document.getElementById('streak-count').textContent=S.streak;
document.getElementById('exercises-done').textContent=S.done;
document.getElementById('level-display').textContent=S.level;
document.getElementById('current-day').textContent=S.day;
// Rituel
const h=new Date().getHours();
const isMorning=h<14;
const rituals=isMorning?morningRituals:eveningRituals;
const r=rituals[S.day%rituals.length];
document.getElementById('ritual-icon').textContent=r.icon;
document.getElementById('ritual-title').textContent=isMorning?'Rituel du matin 🌅':'Rituel du soir 🌙';
document.getElementById('ritual-content').innerHTML=r.steps.map((s,i)=>'<div class="flex items-center gap-3 bg-white/50 rounded-xl p-3"><div class="w-7 h-7 rounded-full bg-purple-100 text-purple-700 flex items-center justify-center text-xs font-bold">'+(i+1)+'</div><span class="text-gray-700 text-sm">'+s+'</span></div>').join('');
// Défi
document.getElementById('weekly-challenge').textContent=weeklyChallenges[Math.floor(S.day/7)%weeklyChallenges.length];
// Phase
const phase=phases.find(p=>S.day>=((p.id-1)*25+1)&&S.day<=(p.id*25));
if(phase){
const dayInPhase=S.day-((phase.id-1)*25);
document.getElementById('current-phase').innerHTML='<div class="flex items-center gap-3 mb-2"><span class="text-2xl">'+phase.emoji+'</span><div><h4 class="font-bold text-gray-800">Phase '+phase.id+' : '+phase.name+'</h4><p class="text-gray-500 text-xs">'+phase.desc+'</p></div></div><div class="w-full h-2 bg-purple-200 rounded-full mt-3"><div class="h-full bg-gradient-to-r '+phase.color+' rounded-full" style="width:'+((dayInPhase/25)*100)+'%"></div></div><p class="text-xs text-gray-500 mt-1">Jour '+dayInPhase+'/25 de cette phase'+(phase.premium?' ⭐ Premium':'')+'</p>';
}
// Greeting
const hour=new Date().getHours();
document.getElementById('greeting').textContent=(hour<12?'Bonjour':hour<18?'Bon après-midi':'Bonsoir')+' toi ! 🌿';
}

// ===== CARTE DU JOUR =====
function renderCard(){
const today=new Date().toDateString();
if(S.cardDate!==today){S.cardFlipped=false;S.cardDate=today;save()}
const card=dailyCards[S.day%dailyCards.length];
document.getElementById('card-emoji').textContent=card.emoji;
document.getElementById('card-title').textContent=card.title;
document.getElementById('card-affirmation').textContent='"'+card.affirmation+'"';
document.getElementById('card-exercise').textContent='🎯 '+card.exercise;
document.getElementById('card-inner').classList.toggle('flipped',S.cardFlipped);
}
function flipCard(){
S.cardFlipped=true;save();
document.getElementById('card-inner').classList.add('flipped');
}

// ===== PROGRAMMES =====
function renderPhases(){
const pc=document.getElementById('phases-container');pc.innerHTML='';
const pct=Math.round((S.day/100)*100);
document.getElementById('total-progress').textContent=pct;
document.getElementById('total-bar').style.width=pct+'%';
document.getElementById('progress-day').textContent=S.day;
phases.forEach(p=>{
const dayInPhase=S.day-((p.id-1)*25);
const phasePct=Math.min(100,Math.max(0,(dayInPhase/25)*100));
const active=S.day>=((p.id-1)*25+1)&&S.day<=(p.id*25);
const done=S.day>(p.id*25);
pc.innerHTML+='<div class="bg-white/70 rounded-2xl p-5 border border-white/80 shadow-lg cursor-pointer hover:shadow-xl transition-all '+(active?'ring-2 ring-purple-400':'')+'" onclick="showPhaseDetail('+p.id+')"><div class="flex items-center gap-4"><div class="w-12 h-12 rounded-xl bg-gradient-to-br '+p.color+' flex items-center justify-center text-xl shadow-lg">'+p.emoji+'</div><div class="flex-1"><div class="flex items-center gap-2"><h3 class="font-bold text-gray-800">Phase '+p.id+' : '+p.name+'</h3>'+(p.premium?'<span class="text-xs px-2 py-0.5 bg-amber-400 text-white rounded-full">⭐</span>':'')+(done?'<span class="text-xs px-2 py-0.5 bg-green-400 text-white rounded-full">✓</span>':'')+'</div><p class="text-gray-500 text-xs">'+p.days+' • '+p.desc+'</p><div class="w-full h-1.5 bg-gray-200 rounded-full mt-2"><div class="h-full bg-gradient-to-r '+p.color+' rounded-full" style="width:'+phasePct+'%"></div></div></div><span class="text-purple-400">→</span></div></div>';
});
}

function showPhaseDetail(id){
const p=phases.find(x=>x.id===id);if(!p)return;
if(p.premium&&!S.isPremium){showScreen('screen-pricing');return}
const cd=document.getElementById('phase-detail-content');
cd.innerHTML='<div class="bg-gradient-to-r '+p.color+' rounded-3xl p-6 text-white shadow-xl mb-6"><h1 class="text-2xl font-bold mb-2">'+p.emoji+' Phase '+p.id+' : '+p.name+'</h1><p class="opacity-90 text-sm">'+p.desc+'</p><p class="text-xs opacity-80 mt-2">'+p.days+'</p></div><div class="space-y-2">';
p.tasks.forEach(t=>{
const done=S.completed.includes('d'+t.d);
cd.innerHTML+='<div class="bg-white/70 rounded-xl p-4 border border-white/80 flex items-center gap-3 '+(done?'opacity-60':'')+'"><div class="w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold '+(done?'bg-green-500 text-white':'bg-gray-200 text-gray-500')+'">'+(done?'✓':t.d)+'</div><div class="flex-1"><p class="font-semibold text-gray-800 text-sm">'+t.t+'</p><p class="text-xs text-gray-500">'+t.type+'</p></div>'+(t.d===S.day&&!done?'<button onclick="completeDay('+t.d+')" class="px-3 py-1.5 bg-gradient-to-r '+p.color+' text-white rounded-lg text-xs font-semibold">Faire ✓</button>':'')+'</div>';
});
cd.innerHTML+='</div>';
showScreen('screen-phase-detail');
}

function completeDay(d){
if(!S.completed.includes('d'+d)){S.completed.push('d'+d);S.done++;S.xp+=20;S.day=Math.max(S.day,d+1);S.streak++;S.lastDate=new Date().toDateString();checkLevel();save()}
showPhaseDetail(Math.ceil(d/25));
}

// ===== EXERCICES =====
function showExercises(filter){
const g=document.getElementById('exercises-grid');g.innerHTML='';
const list=filter&&filter!=='all'?exercises.filter(e=>e.cat===filter):exercises;
list.forEach(e=>{
const done=S.completed.includes(e.id);
const c=document.createElement('button');
c.className='group text-left bg-white/70 rounded-2xl p-5 shadow-md border border-white/80 hover:shadow-xl hover:border-purple-200 transition-all';
c.innerHTML='<div class="flex items-start justify-between mb-3"><span class="text-3xl">'+e.emoji+'</span><div class="flex flex-col items-end gap-1">'+(e.p?'<span class="text-xs px-2 py-0.5 bg-gradient-to-r from-amber-400 to-orange-400 text-white rounded-full font-bold">⭐</span>':'')+(done?'<span class="text-xs px-2 py-0.5 bg-green-500 text-white rounded-full">✓</span>':'')+'</div></div><h3 class="font-bold text-gray-800 mb-1">'+e.title+'</h3><p class="text-gray-500 text-xs mb-3">'+e.desc+'</p><div class="flex items-center gap-2"><span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">⏱️ '+e.dur+'</span><span class="text-xs px-2 py-0.5 bg-gray-100 text-gray-600 rounded-full">'+e.diff+'</span>'+(e.p&&!S.isPremium?'<span class="ml-auto">🔒</span>':'')+'</div>';
c.onclick=()=>{if(e.p&&!S.isPremium)showScreen('screen-pricing');else showExercise(e.id)};
g.appendChild(c);
});
}
function filterEx(cat){document.querySelectorAll('.fbtn').forEach(b=>{b.className='fbtn px-3 py-1.5 rounded-xl text-xs font-medium bg-white/70 text-gray-600 border'});event.target.className='fbtn px-3 py-1.5 rounded-xl text-xs font-medium bg-purple-500 text-white';showExercises(cat)}

function showExercise(id){
const e=exercises.find(x=>x.id===id);if(!e)return;
currentExerciseId=id;
document.getElementById('exercise-content').innerHTML='<div class="flex items-start gap-4 mb-4"><span class="text-4xl">'+e.emoji+'</span><div><h1 class="text-xl font-bold text-gray-800 mb-1">'+e.title+'</h1><div class="flex items-center gap-2"><span class="text-xs text-gray-500">⏱️ '+e.dur+'</span><span class="text-xs text-gray-500">'+e.diff+'</span></div></div></div><p class="text-gray-600 text-sm mb-4">'+e.desc+'</p><div class="bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl p-4 border border-purple-100"><h3 class="font-semibold text-purple-800 text-sm mb-2">✨ Bienfaits</h3><div class="flex flex-wrap gap-1">'+e.ben.map(b=>'<span class="px-2 py-1 bg-white/80 rounded-full text-xs text-purple-700">'+b+'</span>').join('')+'</div></div>';
const sd=document.getElementById('exercise-steps');sd.innerHTML='';
e.steps.forEach((s,i)=>{sd.innerHTML+='<div class="bg-white/70 rounded-xl p-4 border border-gray-200 fade-in" style="animation-delay:'+(i*0.1)+'s"><div class="flex items-start gap-3"><div class="w-8 h-8 rounded-full bg-purple-500 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">'+(i+1)+'</div><div><h3 class="font-bold text-gray-800 text-sm mb-1">'+s.t+'</h3><p class="text-gray-600 text-sm">'+s.d+'</p></div></div></div>'});
document.getElementById('complete-btn').style.display=S.completed.includes(id)?'none':'block';
showScreen('screen-exercise');
}

function completeCurrentExercise(){
if(currentExerciseId&&!S.completed.includes(currentExerciseId)){S.completed.push(currentExerciseId);S.done++;S.xp+=20;checkLevel();save()}
showScreen('screen-library');
}

function completeWeeklyChallenge(){S.xp+=15;S.weekDone=true;checkLevel();save();alert('🎭 Bravo ! Défi accompli ! +15 XP')}

function checkLevel(){const n=S.level*100;while(S.xp>=n){S.xp-=n;S.level++}}

// ===== ÉCRITURE =====
function renderWriting(){
const wp=document.getElementById('writing-prompts');wp.innerHTML='';
writingPrompts.forEach(w=>{
wp.innerHTML+='<div class="bg-white/70 rounded-2xl p-5 border border-white/80 shadow-lg cursor-pointer hover:shadow-xl transition-all" onclick="showWritingDetail(\''+w.id+'\')"><div class="flex items-center gap-4"><span class="text-3xl">'+w.emoji+'</span><div class="flex-1"><div class="flex items-center gap-2"><h3 class="font-bold text-gray-800">'+w.title+'</h3>'+(w.premium?'<span class="text-xs px-2 py-0.5 bg-amber-400 text-white rounded-full">⭐</span>':'')+'</div><p class="text-gray-500 text-sm">'+w.desc+'</p><p class="text-xs text-purple-500 mt-1">Thème : '+w.theme+'</p></div><span class="text-purple-400">→</span></div></div>';
});
}

function showWritingDetail(id){
const w=writingPrompts.find(x=>x.id===id);if(!w)return;
if(w.premium&&!S.isPremium){showScreen('screen-pricing');return}
const cd=document.getElementById('writing-detail-content');
cd.innerHTML='<div class="bg-gradient-to-r from-amber-400 to-orange-400 rounded-3xl p-6 text-white shadow-xl mb-6"><span class="text-4xl">'+w.emoji+'</span><h1 class="text-2xl font-bold mt-2">'+w.title+'</h1><p class="opacity-90 text-sm mt-1">'+w.desc+'</p><p class="text-xs opacity-80 mt-2">Thème : '+w.theme+'</p></div><div class="bg-white/70 rounded-2xl p-6 border border-white/80 mb-6"><h3 class="font-bold text-gray-800 mb-4">📝 Écris ton histoire</h3><textarea id="writing-area" class="w-full h-48 p-4 bg-white/80 rounded-xl border border-gray-200 focus:border-purple-400 outline-none resize-none text-gray-700" placeholder="Laisse venir les mots... Il n\'y a pas de bonne ou mauvaise façon d\'écrire."></textarea><button onclick="saveWriting()" class="mt-3 px-6 py-2 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-xl font-semibold hover:scale-105 transition-all">Enregistrer ✍️</button></div><div class="space-y-3"><h3 class="font-bold text-gray-800">📋 Guide d\'écriture</h3>'+w.steps.map((s,i)=>'<div class="bg-white/70 rounded-xl p-4 border border-gray-200"><div class="flex items-start gap-3"><div class="w-7 h-7 rounded-full bg-amber-400 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">'+(i+1)+'</div><div><h4 class="font-semibold text-gray-800 text-sm">'+s.t+'</h4><p class="text-gray-600 text-sm">'+s.d+'</p></div></div></div>').join('')+'</div>';
showScreen('screen-writing-detail');
}

function saveWriting(){
const text=document.getElementById('writing-area').value;
if(text.trim()){S.xp+=10;S.done++;checkLevel();save();alert('✍️ Bravo ! Ton texte est enregistré. +10 XP')}
}

// ===== CRÉATION =====
function renderCreation(){
const cp=document.getElementById('creation-prompts');cp.innerHTML='';
creationPrompts.forEach(c=>{
cp.innerHTML+='<div class="bg-white/70 rounded-2xl p-5 border border-white/80 shadow-lg cursor-pointer hover:shadow-xl transition-all" onclick="showCreationDetail(\''+c.id+'\')"><div class="flex items-center gap-4"><span class="text-3xl">'+c.emoji+'</span><div class="flex-1"><div class="flex items-center gap-2"><h3 class="font-bold text-gray-800">'+c.title+'</h3>'+(c.premium?'<span class="text-xs px-2 py-0.5 bg-amber-400 text-white rounded-full">⭐</span>':'')+'</div><p class="text-gray-500 text-sm">'+c.desc+'</p><p class="text-xs text-green-600 mt-1">🔄 À transformer : '+c.transform+'</p></div><span class="text-purple-400">→</span></div></div>';
});
}

function showCreationDetail(id){
const c=creationPrompts.find(x=>x.id===id);if(!c)return;
if(c.premium&&!S.isPremium){showScreen('screen-pricing');return}
const cd=document.getElementById('creation-detail-content');
cd.innerHTML='<div class="bg-gradient-to-r from-pink-400 to-rose-400 rounded-3xl p-6 text-white shadow-xl mb-6"><span class="text-4xl">'+c.emoji+'</span><h1 class="text-2xl font-bold mt-2">'+c.title+'</h1><p class="opacity-90 text-sm mt-1">'+c.desc+'</p><div class="bg-white/20 rounded-xl p-3 mt-3"><p class="text-xs font-semibold">🔄 Transformer :</p><p class="text-sm">'+c.transform+'</p></div></div><div class="space-y-3"><h3 class="font-bold text-gray-800">📋 Les étapes</h3>'+c.steps.map((s,i)=>'<div class="bg-white/70 rounded-xl p-4 border border-gray-200"><div class="flex items-start gap-3"><div class="w-7 h-7 rounded-full bg-pink-400 text-white flex items-center justify-center text-xs font-bold flex-shrink-0">'+(i+1)+'</div><div><h4 class="font-semibold text-gray-800 text-sm">'+s.t+'</h4><p class="text-gray-600 text-sm">'+s.d+'</p></div></div></div>').join('')+'</div><div class="mt-6 bg-green-50 rounded-xl p-4 border border-green-200"><p class="text-green-800 text-sm">💡 <strong>Matériel simple :</strong> papier, crayons, ciseaux, colle, objets du quotidien. Pas besoin de matériel artistique professionnel !</p></div>';
showScreen('screen-creation-detail');
}

// ===== PROFIL =====
function renderProfile(){
document.getElementById('p-ex').textContent=S.done;
document.getElementById('p-st').textContent=S.streak;
document.getElementById('p-lv').textContent=S.level;
document.getElementById('p-dy').textContent=S.day;
document.getElementById('level-num').textContent=S.level;
document.getElementById('xp-current').textContent=S.xp;
const xn=S.level*100;
document.getElementById('xp-next').textContent=xn;
document.getElementById('xp-bar').style.width=(S.xp/xn*100)+'%';
document.getElementById('profile-plan').textContent=S.isPremium?'Premium ⭐':'Gratuit';
}
</script>
</body>
</html>
