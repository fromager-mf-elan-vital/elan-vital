--- index.html (原始)
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Élan Vital - Bien-être & Développement personnel</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
<meta name="description" content="Application Elan Vital - Bien-être et développement personnel" />
    <style>
      /* 内联样式确保主题色立即生效，避免闪烁 */
      html,
      body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
      }
      html.light,
      html.light body {
        background-color: #ffffff !important;
        color: #000000;
      }
      html.dark,
      html.dark body {
        background-color: #1a1a1a !important;
        color: #ffffff;
      }
    </style>
    <script>
      // 在 React 加载前立即设置主题，避免闪烁
      (function () {
        const isInIframe = window.self !== window.top;

        function applyThemeToDOM(theme) {
          document.documentElement.classList.remove("light", "dark");
          document.documentElement.classList.add(theme);
          document.documentElement.setAttribute("data-theme", theme);
        }

        if (isInIframe) {
          // 监听父窗口主动推送的主题消息
          window.addEventListener("message", function (event) {
            if (event.data && typeof event.data.theme === "string") {
              const theme = event.data.theme;
              if (theme === "light" || theme === "dark") {
                applyThemeToDOM(theme);
              }
            }
          });
        } else {
          // 非 iframe 环境，使用默认 light 主题
          applyThemeToDOM("light");
        }
      })();
    </script>
      <script>
      (function () {
        if (window.self === window.top) return;
        var reported = {};
        window.addEventListener("error", function (event) {
          // 资源加载失败的 error 事件没有 message，此处仅上报 JS 运行时错误
          if (!event || !event.message) return;
          var key =
            event.message + "|" + (event.filename || "") + "|" + (event.lineno || 0);
          if (reported[key]) return; // 相同错误只上报一次，避免渲染循环刷屏
          reported[key] = true;
          try {
            window.parent.postMessage(
              {
                type: "sandbox-runtime-error",
                payload: {
                  message: String(event.message).slice(0, 500),
                  filename: event.filename || "",
                  lineno: event.lineno || 0,
                  colno: event.colno || 0,
                  stack:
                    event.error && event.error.stack
                      ? String(event.error.stack).slice(0, 2000)
                      : ""
                }
              },
              "*"
            );
          } catch (e) {
            /* 上报失败不影响页面运行 */
          }
        });
      })();
    </script>
  </head>
  <body>
    <div id="root"></div>
    <script type="module" src="/src/main.jsx"></script>
  </body>
</html>


+++ index.html (修改后)
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Élan Vital - Bien-être & Développement personnel</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
@keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
.fade-in{animation:fadeIn .5s ease-out}
.screen{display:none}.screen.active{display:block}
</style>
</head>
<body class="bg-gradient-to-br from-purple-50 via-blue-50 to-pink-50 min-h-screen">
<div id="app">

<!-- ACCUEIL -->
<div id="screen-welcome" class="screen active min-h-screen flex flex-col items-center justify-center px-4 py-12">
<div class="max-w-2xl mx-auto text-center">
<div class="mb-8">
<div class="inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-br from-purple-200 to-pink-200 shadow-xl mb-6"><span class="text-5xl">🌿</span></div>
<h1 class="text-4xl md:text-5xl font-bold bg-gradient-to-r from-purple-700 via-pink-600 to-amber-600 bg-clip-text text-transparent mb-2">Élan Vital</h1>
<p class="text-lg text-gray-500">Bien-être & Développement personnel</p>
</div>
<div class="bg-white/60 rounded-3xl p-8 md:p-10 shadow-xl border border-white/80 mb-8">
<p class="text-xl md:text-2xl text-gray-700 mb-6">Bienvenue, toi. ✨</p>
<p class="text-gray-600 mb-4">Tu as envie de te sentir mieux, de te reconnecter à toi-même ? Tu es au bon endroit.</p>
<p class="text-gray-600 mb-4">Ici, pas de jugement. Juste des <strong class="text-purple-700">exercices bienveillants</strong> pour :</p>
<div class="grid grid-cols-2 gap-3 my-6">
<div class="bg-purple-50 rounded-xl p-3 border border-purple-100"><span class="text-lg">🧘</span><p class="text-sm text-purple-700 mt-1">Mieux te connaître</p></div>
<div class="bg-pink-50 rounded-xl p-3 border border-pink-100"><span class="text-lg">💪</span><p class="text-sm text-pink-700 mt-1">Retrouver ta force</p></div>
<div class="bg-amber-50 rounded-xl p-3 border border-amber-100"><span class="text-lg">🌱</span><p class="text-sm text-amber-700 mt-1">Grandir chaque jour</p></div>
<div class="bg-green-50 rounded-xl p-3 border border-green-100"><span class="text-lg">☀️</span><p class="text-sm text-green-700 mt-1">Vivre pleinement</p></div>
</div>
</div>
<button onclick="showScreen('screen-questionnaire')" class="px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-2xl font-semibold text-lg shadow-xl hover:scale-105 transition-all">Commencer mon parcours →</button>
<div class="mt-10 p-4 bg-green-50/80 rounded-2xl border border-green-200/50">
<p class="text-sm text-green-800">🌿 <strong>Élan Vital</strong> est un outil de développement personnel et de bien-être.</p>
</div>
</div>
</div>

<!-- QUESTIONNAIRE -->
<div id="screen-questionnaire" class="screen min-h-screen flex flex-col items-center justify-center px-4 py-12">
<div class="max-w-2xl mx-auto w-full">
<div class="mb-8">
<div class="flex items-center justify-between mb-2">
<span class="text-sm text-gray-500">Question <span id="q-current">1</span> sur 5</span>
<span class="text-sm text-purple-600 font-medium"><span id="q-percent">20</span>%</span>
</div>
<div class="w-full h-2 bg-purple-100 rounded-full overflow-hidden">
<div id="q-progress" class="h-full bg-gradient-to-r from-purple-400 to-pink-400 rounded-full transition-all duration-500" style="width:20%"></div>
</div>
</div>
<div class="bg-white/70 rounded-3xl p-8 shadow-xl border border-white/80">
<h2 id="q-title" class="text-2xl md:text-3xl font-bold text-gray-800 mb-3"></h2>
<p id="q-subtitle" class="text-gray-500 text-lg italic mb-8"></p>
<div id="q-options" class="space-y-3 mb-8"></div>
<div class="flex items-center justify-between">
<button id="q-back" onclick="prevQuestion()" class="px-5 py-3 text-gray-500 hover:text-gray-700 transition-colors" disabled>← Retour</button>
<button id="q-next" onclick="nextQuestion()" class="px-8 py-3 bg-gradient-to-r from-purple-500 to-pink-500 text-white rounded-xl font-semibold shadow-lg hover:scale-105 transition-all" disabled>Suivant →</button>
</div>
</div>
<p class="text-center text-gray-400 text-sm mt-6">💜 Prends ton temps.</p>
</div>
</div>

<!-- RÉSULTATS -->
<div id="screen-results" class="screen min-h-screen px-4 py-12">
<div class="max-w-4xl mx-auto">
<div class="text-center mb-10">
<div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-purple-200 to-pink-200 shadow-xl mb-6"><span class="text-4xl">✨</span></div>
<h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-3">Merci d'avoir partagé ✨</h1>
<p class="text-lg text-gray-600">Voici les exercices qui correspondent le mieux à ton état d'esprit actuel.</p>
</div>
<div id="r-recommendations" class="bg-white/70 rounded-3xl p-8 shadow-xl border border-white/80 mb-8"></div>
<div class="mb-8">
<h3 class="text-xl font-bold text-gray-800 mb-4">🌈 Explore toutes les approches</h3>
<div class="grid md:grid-cols-2 gap-4">
<button onclick="showScreen('screen-library')" class="text-left p-6 rounded-2xl border-2 bg-indigo-50 border-indigo-200 hover:shadow-lg transition-all"><div class="flex items-center gap-3 mb-2"><span class="text-2xl">🧘</span><h4 class="font-bold text-gray-800">Méditation</h4></div><p class="text-gray-600 text-sm">Apaiser ton mental</p></button>
<button onclick="showScreen('screen-library')" class="text-left p-6 rounded-2xl border-2 bg-green-50 border-green-200 hover:shadow-lg transition-all"><div class="flex items-center gap-3 mb-2"><span class="text-2xl">🌳</span><h4 class="font-bold text-gray-800">Ancrage & Présence</h4></div><p class="text-gray-600 text-sm">Te reconnecter à ton corps</p></button>
<button onclick="showScreen('screen-library')" class="text-left p-6 rounded-2xl border-2 bg-pink-50 border-pink-200 hover:shadow-lg transition-all"><div class="flex items-center gap-3 mb-2"><span class="text-2xl">🎨</span><h4 class="font-bold text-gray-800">Créativité & Expression</h4></div><p class="text-gray-600 text-sm">T'exprimer par la création</p></button>
<button onclick="showScreen('screen-library')" class="text-left p-6 rounded-2xl border-2 bg-amber-50 border-amber-200 hover:shadow-lg transition-all"><div class="flex items-center gap-3 mb-2"><span class="text-2xl">💛</span><h4 class="font-bold text-gray-800">Connaissance de soi</h4></div><p class="text-gray-600 text-sm">Explorer qui tu es vraiment</p></button>
</div>
</div>
<div class="bg-gradient-to-r from-amber-50 to-orange-50 rounded-2xl p-6 border border-amber-200/50 text-center">
<p class="text-amber-800">🌸 Chaque petit pas compte. Choisis un exercice et fais-le à ton rythme.</p>
</div>
</div>
</div>

<!-- BIBLIOTHÈQUE -->
<div id="screen-library" class="screen min-h-screen px-4 py-12">
<div class="max-w-5xl mx-auto">
<button onclick="showScreen('screen-results')" class="flex items-center gap-2 text-gray-500 hover:text-purple-600 mb-6">← Retour</button>
<h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-2">Bibliothèque d'exercices 📚</h1>
<p class="text-gray-600 text-lg mb-8">Explore tous les exercices disponibles.</p>
<div class="mb-8 bg-gradient-to-r from-purple-500 to-pink-500 rounded-2xl p-6 text-white shadow-xl">
<div class="flex flex-col md:flex-row items-center gap-4">
<div class="flex-1"><h3 class="text-xl font-bold mb-2">✨ Débloque tous les exercices</h3><p class="text-purple-100 text-sm">Accède à tous les exercices premium + nouveautés chaque mois.</p></div>
<button onclick="showScreen('screen-pricing')" class="px-6 py-3 bg-white text-purple-600 rounded-xl font-bold hover:scale-105 transition-transform shadow-lg">Voir les offres →</button>
</div>
</div>
<div id="exercises-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
</div>
</div>

<!-- EXERCICE -->
<div id="screen-exercise" class="screen min-h-screen px-4 py-12">
<div class="max-w-3xl mx-auto">
<button onclick="showScreen('screen-library')" class="flex items-center gap-2 text-gray-500 hover:text-purple-600 mb-6">← Retour</button>
<div id="exercise-content" class="bg-white/70 rounded-3xl p-8 shadow-xl border border-white/80 mb-8"></div>
<div id="exercise-steps" class="space-y-4 mb-8"></div>
</div>
</div>

<!-- TARIFICATION -->
<div id="screen-pricing" class="screen min-h-screen px-4 py-12">
<div class="max-w-4xl mx-auto">
<button onclick="showScreen('screen-library')" class="flex items-center gap-2 text-gray-500 hover:text-purple-600 mb-6">← Retour</button>
<div class="text-center mb-10">
<div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-gradient-to-br from-amber-200 to-orange-200 shadow-xl mb-6"><span class="text-4xl">⭐</span></div>
<h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-3">Passe au niveau supérieur</h1>
<p class="text-gray-600 text-lg">Débloque tous les exercices premium.</p>
</div>
<div class="grid md:grid-cols-2 gap-6 mb-10">
<div class="bg-white/70 rounded-3xl p-8 border-2 border-gray-200">
<div class="text-center mb-6"><h3 class="text-xl font-bold text-gray-800 mb-1">Gratuit</h3><div class="mt-4"><span class="text-4xl font-bold">0€</span></div></div>
<ul class="space-y-3 mb-8">
